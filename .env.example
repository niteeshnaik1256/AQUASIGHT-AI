# AQUASIGHT AI - Frontend Environment Configuration
# Copy this file to .env.local and configure the values for your environment.

# Backend API URL
# Base URL for the FastAPI Python hydrological simulation backend.
# If empty, the frontend will fall back to the isolated local demonstration storage.
# Default: http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
